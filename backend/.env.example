# Database (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/educompiler
# DATABASE_URL=sqlite:///./educompiler.db

# Clerk JWT verification (from Clerk Dashboard → API Keys → Advanced → JWKS)
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# Local dev without Clerk — required for Save without Clerk JWT
AUTH_DISABLED=true

EDU_HOST=0.0.0.0
EDU_PORT=8000
